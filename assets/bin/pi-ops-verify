#!/usr/bin/env bash
# pi-ops-verify —— 部署架构文档驱动的部署验证(只读)
# 用法: pi-ops-verify <架构文档.md> [输出报告.md]
# 退出码:0=全部符合 / 1=存在不符项或无法完成 / 2=用法错误(可挂 cron 告警)
#
# 架构(防幻觉设计):
#   文档含 ```deploy-spec 块 → verify-check.js【确定性实测】(ss/pgrep/systemctl/curl/fs/net)
#   → 实测表 + 期望清单 交给 agent → agent 只做"对照判定 + 汇总 + 修复建议",
#   禁止自行探测(杜绝小模型编造证据);无 spec 块则整篇文档自由理解(建议配 4b)。
set -euo pipefail

DOC="${1:?用法: pi-ops-verify <架构文档.md> [输出报告.md]}"
OUT="${2:-verify-report-$(date +%Y%m%d-%H%M%S).md}"
PI_OPS_HOME="${PI_OPS_HOME:-$HOME/pi-ops-agent}"
[ -f "$DOC" ] || { echo "文档不存在: $DOC" >&2; exit 2; }
P="$PI_OPS_HOME/bin/pi-ops"
[ -x "$P" ] || { echo "未找到 $P,请先运行 install.sh" >&2; exit 2; }
NODE="$PI_OPS_HOME/node/bin/node"; command -v node >/dev/null 2>&1 && NODE="$(command -v node)"
[ -x "$NODE" ] || NODE="$PI_OPS_HOME/node/bin/node"

# 提取 ```deploy-spec 块(不存在则为空)
SPEC_FILE="/tmp/pi-ops-spec.$$"
awk '/^``` *deploy-spec/{f=1;next} f && /^```/{f=0;next} f' "$DOC" > "$SPEC_FILE"

PROMPT_HEAD='你是 pi-ops-agent 的【部署验证模式】。规则:
1. 只做只读操作;危险命令会被审批门拦截
2. 网络探测一律 -m 3 超时,不通就标记,不要卡住
3. 用中文,直接输出报告正文'

if [ -s "$SPEC_FILE" ]; then
  # ---- 确定性实测层 ----
  FACTS="$("$NODE" "$PI_OPS_HOME/lib/verify-check.js" "$SPEC_FILE")" || {
    echo "[pi-ops-verify] 实测层执行失败:" >&2; echo "$FACTS" >&2; exit 1; }
  RESULT_LINE="$(printf '%s\n' "$FACTS" | grep '^RESULT ' | tail -1)"
  FAILED="$(echo "$RESULT_LINE" | sed -n 's/.*failed=\([0-9]*\).*/\1/p')"

  PROMPT="$PROMPT_HEAD

下面是【期望】(deploy-spec 清单)与【实测结果】(脚本已确定性探测,真实可信)。
你的任务是对照两者输出最终验证报告:
- 逐项判定,判定结论必须与实测一致(实测"不符"就是 ❌,不得翻案)
- 输出:逐项表格(名称/期望/实测/结论/证据)+ 汇总(通过/失败计数)+ 每个 ❌ 一句话修复建议
- 除实测表明确标注未覆盖的项外,禁止重新探测;确需补充探测时用只读命令并在证据里注明

【期望清单】:
$(cat "$SPEC_FILE")

【实测结果】:
$FACTS"
else
  echo "[pi-ops-verify] 注意:文档无 deploy-spec 块,走自由理解通道(小模型可靠性有限,建议补 spec 块或用 4b)" >&2
  PROMPT="$PROMPT_HEAD

部署架构文档全文,请逐项验证并输出:逐项表格(✅/❌/⚠️+证据)+ 汇总 + 失败项修复建议:
$(cat "$DOC")"
fi

echo "[pi-ops-verify] 文档:$DOC  报告:$OUT"
if command -v timeout >/dev/null 2>&1; then TO="timeout ${PI_VERIFY_TIMEOUT:-900}"; else TO=""; fi
# 注意:pi -p 会等 stdin EOF,非交互必须显式关闭
RC=0
$TO "$P" -p "$PROMPT" < /dev/null | tee "$OUT" || RC=$?
rm -f "$SPEC_FILE"

if [ -n "${FAILED:-}" ] && [ "$FAILED" -gt 0 ]; then
  echo "[pi-ops-verify] 完成:实测存在 $FAILED 项不符(详见报告)" >&2
  exit 1
fi
echo "[pi-ops-verify] 完成:实测全部符合,报告已存 $OUT"
exit "$RC"
